flowchart LR
    classDef core fill:#eef4ff,stroke:#3567c7,color:#0f2547
    classDef provider fill:#fff7e8,stroke:#c98a12,color:#0f2547
    classDef outcome fill:#ecf8f1,stroke:#2f8f5b,color:#0f2547

    records["Recorded decision<br/>and evidence"]:::core
    request["Explanation request<br/>and audience"]:::core
    providers["Policy, attribution and<br/>explanation providers"]:::provider
    optin["Explicit opt-in for<br/>LLM-backed explanations"]:::provider
    result["Audience-filtered explanation<br/>with disclosure notes"]:::outcome
    refused["Failure: no explanation returned"]:::outcome

    records --> request
    providers -.-> request
    optin -.-> request
    request --> result
    request -. "policy or generation failure" .-> refused
