classDiagram
    direction LR
    class Execution {
        context: ExecutionContext
        status: ExecutionStatus
        started_at / ended_at
        continuation_of: run_id
        nodes: NodeExecution[]
        state_transitions: StateTransition[]
        tools: ToolExecution[]
        retrievals: RetrievalExecution[]
        memory: MemoryReference[]
        checkpoints: CheckpointReference[]
        human_interactions: HumanInteraction[]
        exceptions: ExceptionEvent[]
    }
    class ExecutionContext {
        application_id / tenant_id / graph_id
        run_id
        thread_id / trace_id / checkpoint_id
    }
    class Evidence {
        evidence_type
        summary
        content_reference
        confidence / quality
    }
    class Decision {
        decision_type
        selected_action
        candidate_actions
        factors: DecisionFactor[]
        evidence_ids
        confidence / uncertainty
    }
    class ProvenanceLink {
        source_id
        relation
        target_id
    }
    class AttributionResult {
        method
        contributions: AttributionContribution[]
        normalized
        confidence
    }
    class AttributionContribution {
        factor_id
        factor_type
        score
        evidence_ids
    }
    class EvidenceReference {
        evidence_id
        relationship
    }
    class Explanation {
        audience
        summary
        reasons
        contributing_factors: AttributionContribution[]
        supporting_evidence: EvidenceReference[]
        disclosure
    }
    Execution *-- ExecutionContext : context
    Decision --> Evidence : evidence_ids
    ProvenanceLink ..> Evidence : source_id or target_id
    ProvenanceLink ..> Decision : source_id or target_id
    AttributionResult *-- AttributionContribution : contributions
    Explanation *-- AttributionContribution : contributing_factors
    Explanation *-- EvidenceReference : supporting_evidence
    EvidenceReference --> Evidence : evidence_id
