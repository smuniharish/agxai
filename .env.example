# Example environment for agxai development. agxai itself reads no environment
# variables: runtime behaviour is configured in code, per XAIRuntime instance.
# Each variable below is read by the component named in its group heading.
# Never commit real credentials.

# Read by the SDK clients that LangSmithObservability() and
# LangfuseObservability() create when no client is passed in.
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=

# Read by the model-backed examples (examples/_shared.py) and
# scripts/run-live-llm-evaluation.py.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=

# Read by examples/postgres_store.py.
XAI_POSTGRES_DSN=

# Read by the opt-in live test suites (see docs/development/testing.md). Point
# them at disposable services; pytest skips each suite when its variables are
# unset.
XAI_TEST_POSTGRES_DSN=
XAI_TEST_OTEL_ENDPOINT=
XAI_TEST_LANGFUSE_HOST=
XAI_TEST_LANGFUSE_PUBLIC_KEY=
XAI_TEST_LANGFUSE_SECRET_KEY=
XAI_TEST_LLM_API_KEY=
XAI_TEST_LLM_BASE_URL=
XAI_TEST_LLM_MODEL=